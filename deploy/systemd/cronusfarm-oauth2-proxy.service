[Unit]
Description=CronusFarm oauth2-proxy (Google)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/cronusfarm/oauth2-proxy.env
ExecStart=/bin/bash -c '/usr/local/bin/oauth2-proxy --config=/etc/cronusfarm/oauth2-proxy.cfg --cookie-secret="$(tr -d "\n" </etc/cronusfarm/oauth2-cookie-secret)"'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
