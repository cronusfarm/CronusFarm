[Unit]
Description=CronusFarm AI 카메라 MJPEG (8081 /video_feed)
# Node-RED(MQTT·플로우) 준비 후 기동 — nodered.service.d/20-cronusfarm-camera-ai.conf 가 NR 기동 시 try-restart
After=network-online.target mosquitto.service nodered.service
Wants=network-online.target

[Service]
Type=simple
User=dooly
Group=dooly
WorkingDirectory=/home/dooly/CronusFarm
Environment=PYTHONUNBUFFERED=1
# 첫 실행 시 yolov8s-world.pt 다운로드로 지연될 수 있음
TimeoutStartSec=300
ExecStart=/usr/bin/python3 /home/dooly/CronusFarm/scripts/cronusfarm_camera_ai.py
Restart=on-failure
RestartSec=8

[Install]
WantedBy=multi-user.target
