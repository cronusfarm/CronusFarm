[Unit]
Description=CronusFarm AI 카메라 MJPEG (8081 /video_feed, Hailo 미사용 시 폴백)
# Hailo best.hef 있으면 cronusfarm-hailo-stream 사용 — 이 서비스는 기동하지 않음
ConditionPathExists=!/home/dooly/CronusFarm/Hailo/best.hef
After=network-online.target mosquitto.service nodered.service
Wants=network-online.target
Conflicts=cronusfarm-hailo-stream.service

[Service]
Type=simple
User=dooly
Group=dooly
WorkingDirectory=/home/dooly/CronusFarm
Environment=PYTHONUNBUFFERED=1
# 첫 실행 시 yolov8s-world.pt 다운로드로 지연될 수 있음
TimeoutStartSec=300
ExecStart=/usr/bin/python3 /home/dooly/CronusFarm/scripts/cronusfarm_camera_ai.py
Restart=on-failure
RestartSec=8

[Install]
WantedBy=multi-user.target
