[Unit]
Description=CronusFarm CSI camera MJPEG (imx219 cam0 :8082)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dooly
Group=dooly
Environment=PYTHONUNBUFFERED=1
Environment=CRONUSFARM_CSI_HTTP_PORT=8082
Environment=CRONUSFARM_CSI_WIDTH=640
Environment=CRONUSFARM_CSI_HEIGHT=480
Environment=CRONUSFARM_CSI_FPS=15
ExecStart=/usr/bin/python3 /home/dooly/CronusFarm/scripts/cronusfarm_csi_mjpeg.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
