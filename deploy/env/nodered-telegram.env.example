# Pi 에 복사: /etc/cronusfarm/nodered-telegram.env (chmod 600)
# 일괄 병합: bash ~/CronusFarm/scripts/pi-apply-nodered-cronusfarm-env.sh
# BotFather 토큰, 본인 chat_id(숫자)
CRONUSFARM_TELEGRAM_BOT_TOKEN=
CRONUSFARM_TELEGRAM_CHAT_ID=

# Node-RED tele→SQLite (미설정 시 코드 기본값: URL 127.0.0.1:18766, MIN_MS 15000)
CRONUSFARM_SQLITE_BRIDGE_URL=http://127.0.0.1:18766
CRONUSFARM_SQLITE_MIN_MS=5000

# (선택) 날씨 조회용 위치(농장 외부 날씨)
# - Open-Meteo 사용(키 불필요)
# - 서울 강동 천호동 432-11 (천호대로151길 36) 예시:
CRONUSFARM_WEATHER_LAT=37.54294
CRONUSFARM_WEATHER_LON=127.12733
CRONUSFARM_WEATHER_NAME=서울 강동 천호동 농장
CRONUSFARM_KMA_NX=71
CRONUSFARM_KMA_NY=127
# 텔레그램 AI (Pi Ollama)
CRONUSFARM_OLLAMA_ENABLED=1
CRONUSFARM_OLLAMA_MODEL=gemma:2b
CRONUSFARM_OLLAMA_HOST=http://127.0.0.1:11434

# 텔레그램 사진 AI (작물·해충·방제) — gemini 권장
CRONUSFARM_VISION_ENABLED=1
CRONUSFARM_VISION_PROVIDER=gemini
CRONUSFARM_GEMINI_API_KEY=
# 2.0-flash(-lite) 무료 한도 0(429)인 API 키가 많음 → 2.5-flash-lite 권장
CRONUSFARM_GEMINI_MODEL=gemini-2.5-flash-lite
# 429 시 순서대로 시도 (쉼표 구분)
CRONUSFARM_GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-2.0-flash-lite
# CRONUSFARM_OPENAI_API_KEY=
# CRONUSFARM_OPENAI_VISION_MODEL=gpt-4o-mini
# CRONUSFARM_OLLAMA_VISION_MODEL=llava
CRONUSFARM_VISION_SCRIPT=/home/dooly/CronusFarm/scripts/cronusfarm_telegram_vision.py
