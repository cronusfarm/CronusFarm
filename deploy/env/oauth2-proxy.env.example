# Pi: sudo cp deploy/env/oauth2-proxy.env.example /etc/cronusfarm/oauth2-proxy.env
# Google Cloud Console → OAuth 클라이언트(웹) → 승인된 리디렉션 URI:
#   https://cronusfarm.duckdns.org/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_REDIRECT_URL=https://cronusfarm.duckdns.org/oauth2/callback
OAUTH2_PROXY_EMAIL_DOMAINS=*
