,"colors":["#3399ff","#00b500","#ca3838"],"seg1":"22","seg2":"28","diff":false,"className":"","x":780,"y":380,"wires":[]},{"id":"d803759f55603ec6","type":"function","z":"02ccfe788704ab49","name":"chart series","func":"const d = msg.device || 'unknown';\nconst p = msg.payload || {};\nconst out = [];\nif (p.ph   !== undefined) out.push({ topic: `${d}:pH`,   payload: p.ph });\nif (p.ec   !== undefined) out.push({ topic: `${d}:EC`,   payload: p.ec });\nif (p.temp !== undefined) out.push({ topic: `${d}:Temp`, payload: p.temp });\nreturn [out];\n","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":590,"y":420,"wires":[["d7b0b47e7833847a"]]},{"id":"d7b0b47e7833847a","type":"ui_chart","z":"tab_cronus_dash","name":"phc493/phw3988 24h","group":"ui_grp_gh_data","order":4,"width":7,"height":6,"label":"Water Quality (24h)","chartType":"line","legend":"true","xformat":"HH:mm","interpolate":"linear","nodata":"no data","dot":false,"ymin":"","ymax":"","removeOlder":"24","removeOlderPoints":"","removeOlderUnit":"3600","cutout":0,"useOneColor":false,"useUTC":false,"colors":["#1f77b4","#ff7f0e","#d62728","#2ca02c","#9467bd","#8c564b","#000000","#000000","#000000"],"outputs":1,"useDifferentColor":false,"className":"","x":800,"y":420,"wires":[[]]},{"id":"201f991e49bff34f","type":"function","z":"02ccfe788704ab49","name":"fn_map_phw3988","func":"// PH-W3988 (Tuya dgnbj, proto 3.5) — DP from tuya-local #555/#562 + IoT shadow\n// 8 temp°C×10, 102 pH×100, 107 TDS ppm, 110 EC µS/cm, 113 salinity ppm, 116 S.G×1000, 119 ORP mV (optional)\nconst DEVICE = 'phw3988';\nconst MAP = {\n  temp: { dp: '8', scale: 10 },\n  ph:   { dp: '102', scale: 100 },\n  tds:  { dp: '107', scale: 1 },\n  ec:   { dp: '110', scale: 1 },\n  salt: { dp: '113', scale: 1 },\n  sg:   { dp: '116', scale: 1000 }\n};\n\nlet src = null;\nconst p = msg.payload;\nif (p && typeof p === 'object') {\n  if (p.dps && typeof p.dps === 'object') src = p.dps;\n  else if (p.data && p.data.dps && typeof p.data.dps === 'object') src = p.data.dps;\n  else if (Object.keys(p).every(k => /^\\d+$/.test(k))) src = p;\n}\nif (!src || typeof src !== 'object') return null;\n\nconst norm = {};\nfor (const [k, v] of Object.entries(src)) norm[String(k)] = v;\nsrc = norm;\n\nconst parsed = { ts: new Date().toISOString() };\nfor (const [k, cfg] of Object.entries(MAP)) {\n  const raw = src[cfg.dp];\n  if (raw === undefined || raw === null) continue;\n  const v = Number(raw) / cfg.scale;\n  if (Number.isFinite(v)) parsed[k] = Math.round(v * 1000) / 1000;\n}\n\nconst key = 'last_' + DEVICE;\nconst last = flow.get(key) || {};\nconst merged = Object.assign({}, last, parsed);\nflow.set(key, merged);\nmsg.payload = merged;\nmsg.device = DEVICE;\nreturn msg;\n","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":350,"y":340,"wires":[["d5483828b614bd88","874f552956291ad6","4fa53d4c97a59637","b22f8d4f771bb409","f951ab2f0f813b4d","9651686f7f601ac8","d803759f55603ec6","554c1b474239d145"]]},{"id":"554c1b474239d145","type":"function","z":"02ccfe788704ab49","name":"split topics","func":"const dev = msg.device || 'unknown';\nconst p = msg.payload || {};\nconst out = [];\nfor (const k of ['ph','ec','tds','salt','sg','temp']) {\n  if (p[k] !== undefined) out.push({ topic: `aquarium/${dev}/${k}`, payload: p[k] });\n}\nout.push({ topic: `aquarium/${dev}/json`, payload: JSON.stringify(p) });\nreturn [out];\n","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":590,"y":240,"wires":[["d93926e2264775ad"]]},{"id":"d93926e2264775ad","type":"function","z":"02ccfe788704ab49","name":"to sf_3team/water JSON","func":"const p = msg.payload || {};\n// msg.payload가 string(JSON)으로 들어오는 경우도 있으니 보정\nlet obj = p;\nif (typeof obj === 'string') {\n  try { obj = JSON.parse(obj); } catch (e) { return null; }\n}\nif (!obj || typeof obj !== 'object') return null;\n\n// Arduino가 기대하는 키: ph, ec, temp\nconst out = {\n  ph: obj.ph,\n  ec: obj.ec,\n  temp: obj.temp\n};\n\n// 값이 하나도 없으면 publish 안 함\nif (out.ph === undefined && out.ec === undefined && out.temp === undefined) return null;\n\nmsg.topic = 'sf_3team/water';\nmsg.payload = JSON.stringify(out);\nreturn msg;\n","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":810,"y":240,"wires":[["4fd2979510810d5f"]]},{"id":"4fd2979510810d5f","type":"mqtt out","z":"02ccfe788704ab49","name":"To Arduino (sf_3team/water)","topic":"","qos":"1","retain":"false","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"d7013a5209d5fe9b","x":1080,"y":240,"wires":[]},{"id":"8ed219bf73293e78","type":"tuya-smart-device","z":"02ccfe788704ab49","deviceName":"PHW3988","disableAutoStart":false,"deviceId":"eba68f314e4fcc18b6mhqz","deviceKey":"ew8>D|NsoxPl-;IT","storeAsCreds":false,"deviceIp":"192.168.60.132","retryTimeout":"30000","findTimeout":"30000","tuyaVersion":"3.5","eventMode":"event-both","logLevel":"log-level-error","x":150,"y":300,"wires":[["2c66449a4d7d4656","201f991e49bff34f"],[]]}]