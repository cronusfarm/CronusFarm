    {
      "type": "timeseries",
      "title": "환경 (temp·humidity·ph·ec)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "influxdb",
        "uid": "efjwqrorrfxtsf"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "efjwqrorrfxtsf"
          },
          "query": "from(bucket: \"cronusfarm\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tele\" and r._field == \"temp\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
