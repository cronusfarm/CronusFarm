#pragma once

// 이 파일을 복사해 `secrets.h` 로 저장한 뒤 값만 채운다. `secrets.h` 는 Git에 커밋하지 않는다.
// WiFi 후보 AP — WIFI_AP_SSIDS 와 WIFI_AP_PASSES 의 **순서·개수**를 반드시 맞출 것.

static const char* const WIFI_AP_SSIDS[] = {
  "YOUR_AP_SSID_FIRST",
  "YOUR_AP_SSID_SECOND",
};

static const char* const WIFI_AP_PASSES[] = {
  "YOUR_AP_PASS_FIRST",
  "YOUR_AP_PASS_SECOND",
};

static const int WIFI_AP_COUNT = sizeof(WIFI_AP_SSIDS) / sizeof(WIFI_AP_SSIDS[0]);

// MQTT 브로커 — Pi Mosquitto. MQTT_HOST 에 포트(:1883)를 넣지 말 것(반드시 아래 MQTT_PORT 사용).
// UNO R4 WiFi(WiFiS3)는 `*.local`(mDNS)·Tailscale 호스트명이 해석되지 않는 경우가 많음 → Pi LAN 고정 IP만.
#define MQTT_HOST "192.168.60.222"
#define MQTT_PORT 1883

// connectMqtt() 가 사용 — host는 문자열 리터럴(MQTT_HOST)만 넣을 것
struct CronusMqttBroker {
  const char* host;
  uint16_t port;
};
static const CronusMqttBroker MQTT_BROKERS[] = {
  { MQTT_HOST, MQTT_PORT },
};
static const int MQTT_BROKER_COUNT =
  (int)(sizeof(MQTT_BROKERS) / sizeof(MQTT_BROKERS[0]));

#define MQTT_USER ""
#define MQTT_PASS ""

#define DEVICE_ID "cronusfarm-01"

#define MQTT_TOPIC_PI_WIFI_SSID "cronusfarm/pi/wifi_ssid"

// HTTP tele 백업 (MQTT 실패 시 Pi 브리지 ingest) — MQTT_HOST 와 동일 LAN IP 권장
#define BRIDGE_HTTP_HOST "192.168.60.222"
#define BRIDGE_HTTP_PORT 80
#define BRIDGE_HTTP_PATH "/farm/cronusfarm-sqlite/ingest/tele"
#define CRONUS_HTTP_TELE_BACKUP 1

// USB 시리얼 primary (Pi 상시 연결) — MQTT farm 채널 비활성, tele/cmd는 ttyACM
// 롤백: CRONUSFARM_MQTT_ENABLE 1, Pi scripts/pi-enable-r4-mqtt-fallback.sh
#define CRONUSFARM_MQTT_ENABLE 0
