#pragma once

// 이 파일을 복사해 `secrets.h` 로 저장한 뒤 값만 채운다. `secrets.h` 는 Git에 커밋하지 않는다.
// WiFi 후보 AP — WIFI_AP_SSIDS 와 WIFI_AP_PASSES 의 **순서·개수**를 반드시 맞출 것.

static const char* const WIFI_AP_SSIDS[] = {
  "YOUR_AP_SSID_FIRST",
  "YOUR_AP_SSID_SECOND",
};

static const char* const WIFI_AP_PASSES[] = {
  "YOUR_AP_PASS_FIRST",
  "YOUR_AP_PASS_SECOND",
};

static const int WIFI_AP_COUNT = sizeof(WIFI_AP_SSIDS) / sizeof(WIFI_AP_SSIDS[0]);

// MQTT 브로커 — Pi Mosquitto. MQTT_HOST 에 포트(:1883)를 넣지 말 것(반드시 아래 MQTT_PORT 사용).
// UNO R4 WiFi(WiFiS3)는 PC와 달리 `*.local`(mDNS) 이름이 해석되지 않는 경우가 많음 → Pi LAN 고정 IP 권장.
#define MQTT_HOST "192.168.0.10"
#define MQTT_PORT 1883

#define MQTT_USER ""
#define MQTT_PASS ""

#define DEVICE_ID "cronusfarm-01"

#define MQTT_TOPIC_PI_WIFI_SSID "cronusfarm/pi/wifi_ssid"
